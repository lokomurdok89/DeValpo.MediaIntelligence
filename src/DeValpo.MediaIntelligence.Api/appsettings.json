{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MediaIntelligence": "Host=localhost;Port=5435;Database=media_intelligence;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/media-assets"
  },
  "GoogleDocumentAi": {
    "Enabled": false,
    "ProjectId": "",
    "Location": "",
    "ProcessorId": "",
    "CredentialsPath": "",
    "AllowUserCredentials": false
  },
  "GoogleVideoIntelligence": {
    "Enabled": false,
    "CredentialsPath": "",
    "BucketName": "",
    "AllowUserCredentials": false,
    "RemoteOperationTimeoutSeconds": 7200
  },
  "AwsRekognition": {
    "Enabled": false,
    "FaceSearchEnabled": false,
    "Region": "",
    "BucketName": "",
    "CollectionId": "",
    "CredentialsPath": "",
    "ProfileName": "",
    "AllowUserCredentials": false,
    "MinSimilarity": 90,
    "UsePolling": true,
    "PollingIntervalSeconds": 5,
    "PollingTimeoutSeconds": 900,
    "StagingPrefix": "face-search",
    "DeleteStagedObjectsAfterProcessing": true,
    "SnsTopicArn": "",
    "RoleArn": ""
  },
  "Skills": {
    "EnableMockSkills": false
  },
  "AnalysisProfiles": {
    "EnableMockProfiles": false
  },
  "Jwt": {
    "Issuer": "DeValpo.MediaIntelligence",
    "Audience": "DeValpo.MediaIntelligence.Api",
    "SigningKey": "dev-only-change-me-32-chars-minimum-key",
    "RequireHttpsMetadata": false,
    "AccessTokenMinutes": 60
  },
  "MediaAnalysis": {
    "MaxFileSizeBytes": 104857600,
    "MaxProcessingAttempts": 3,
    "PdfEofTailBytes": 4096
  },
  "VideoAnalysis": {
    "MaxVideosPerJob": 5,
    "MaxVideoSizeBytes": 1073741824,
    "MaxDurationSeconds": 3600,
    "MaxProcessingAttempts": 3,
    "DefaultMinConfidence": 0.7,
    "DefaultMergeGapSeconds": 2,
    "FaceMatchingEnabled": false
  },
  "AnalysisWorker": {
    "Enabled": true,
    "PollIntervalSeconds": 2
  },
  "WebhookDelivery": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "MaxAttempts": 3,
    "InitialBackoffSeconds": 5,
    "RequestTimeoutSeconds": 10
  },
  "Readiness": {
    "RequireGoogleDocumentAi": false,
    "CheckGoogleDocumentAiRemote": false,
    "TimeoutSeconds": 10
  },
  "GoogleDocumentAiStatusCache": {
    "RemoteStatusTtlSeconds": 60,
    "RemoteStatusTimeoutSeconds": 10
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
