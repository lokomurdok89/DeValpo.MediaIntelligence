ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__MediaIntelligence=Host=<postgres-host>;Port=5432;Database=<database>;Username=<username>;Password=<secret-manager-password>
Database__ApplyMigrationsOnStartup=false
Storage__Provider=Local
Storage__LocalRootPath=/app/storage/media-assets
GoogleDocumentAi__Enabled=true
GoogleDocumentAi__ProjectId=<project-id>
GoogleDocumentAi__Location=<location>
GoogleDocumentAi__ProcessorId=<processor-id>
GoogleDocumentAi__CredentialsPath=<managed-credential-path-if-needed>
GoogleDocumentAi__AllowUserCredentials=false
Skills__EnableMockSkills=false
AnalysisProfiles__EnableMockProfiles=false
Jwt__Issuer=DeValpo.MediaIntelligence
Jwt__Audience=DeValpo.MediaIntelligence.Api
Jwt__SigningKey=<secret-manager-value-min-32-bytes>
Jwt__RequireHttpsMetadata=true
Jwt__AccessTokenMinutes=30
MediaAnalysis__MaxFileSizeBytes=104857600
MediaAnalysis__MaxProcessingAttempts=3
MediaAnalysis__PdfEofTailBytes=4096
AnalysisWorker__Enabled=true
AnalysisWorker__PollIntervalSeconds=2
WebhookDelivery__Enabled=true
WebhookDelivery__PollIntervalSeconds=2
WebhookDelivery__MaxAttempts=3
WebhookDelivery__InitialBackoffSeconds=5
WebhookDelivery__RequestTimeoutSeconds=10
Readiness__RequireGoogleDocumentAi=true
Readiness__CheckGoogleDocumentAiRemote=true
Readiness__TimeoutSeconds=10
GoogleDocumentAiStatusCache__RemoteStatusTtlSeconds=60
GoogleDocumentAiStatusCache__RemoteStatusTimeoutSeconds=10
Swagger__Enabled=false
