{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MediaIntelligence": "Host=localhost;Port=5435;Database=media_intelligence;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/media-assets"
  },
  "GoogleDocumentAi": {
    "Enabled": false,
    "ProjectId": "",
    "Location": "",
    "ProcessorId": "",
    "CredentialsPath": ""
  },
  "MediaAnalysis": {
    "MaxFileSizeBytes": 104857600
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
