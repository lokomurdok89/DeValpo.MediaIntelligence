{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MediaIntelligence": "Host=localhost;Port=5435;Database=media_intelligence;Username=postgres;Password=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/media-assets"
  },
  "GoogleDocumentAi": {
    "Enabled": false,
    "ProjectId": "",
    "Location": "",
    "ProcessorId": "",
    "CredentialsPath": "",
    "AllowUserCredentials": false
  },
  "Skills": {
    "EnableMockSkills": false
  },
  "AnalysisProfiles": {
    "EnableMockProfiles": false
  },
  "Jwt": {
    "Issuer": "DeValpo.MediaIntelligence",
    "Audience": "DeValpo.MediaIntelligence.Api",
    "SigningKey": "dev-only-change-me-32-chars-minimum-key",
    "RequireHttpsMetadata": false,
    "AccessTokenMinutes": 60
  },
  "MediaAnalysis": {
    "MaxFileSizeBytes": 104857600,
    "MaxProcessingAttempts": 3,
    "PdfEofTailBytes": 4096
  },
  "AnalysisWorker": {
    "Enabled": true,
    "PollIntervalSeconds": 2
  },
  "WebhookDelivery": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "MaxAttempts": 3,
    "InitialBackoffSeconds": 5,
    "RequestTimeoutSeconds": 10
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
