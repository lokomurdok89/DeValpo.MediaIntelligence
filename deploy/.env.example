ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__MediaIntelligence=Host=postgres;Port=5432;Database=media_intelligence;Username=postgres;Password=postgres
Database__ApplyMigrationsOnStartup=true
Storage__Provider=Local
Storage__LocalRootPath=/app/storage/media-assets
GoogleDocumentAi__Enabled=true
GoogleDocumentAi__ProjectId=primeval-wind-499515-k6
GoogleDocumentAi__Location=us
GoogleDocumentAi__ProcessorId=44b3274ce1e84552
GoogleDocumentAi__CredentialsPath=/run/secrets/google-application-default-credentials.json
GoogleDocumentAi__AllowUserCredentials=true
GoogleVideoIntelligence__Enabled=false
GoogleVideoIntelligence__CredentialsPath=/run/secrets/google-application-default-credentials.json
GoogleVideoIntelligence__BucketName=
GoogleVideoIntelligence__AllowUserCredentials=true
GoogleVideoIntelligence__RemoteOperationTimeoutSeconds=7200
GoogleVision__Enabled=false
GoogleVision__CredentialsPath=/run/secrets/google-application-default-credentials.json
GoogleVision__AllowUserCredentials=true
AwsRekognition__Enabled=false
AwsRekognition__FaceSearchEnabled=false
AwsRekognition__Region=
AwsRekognition__BucketName=
AwsRekognition__CollectionId=
AwsRekognition__CredentialsPath=/run/secrets/aws-credentials
AwsRekognition__ProfileName=default
AwsRekognition__AllowUserCredentials=true
AwsRekognition__MinSimilarity=90
AwsRekognition__UsePolling=true
AwsRekognition__PollingIntervalSeconds=5
AwsRekognition__PollingTimeoutSeconds=900
AwsRekognition__StagingPrefix=staging
AwsRekognition__DeleteStagedObjectsAfterProcessing=false
AwsRekognition__SnsTopicArn=
AwsRekognition__RoleArn=
Skills__EnableMockSkills=true
AnalysisProfiles__EnableMockProfiles=true
Jwt__Issuer=DeValpo.MediaIntelligence
Jwt__Audience=DeValpo.MediaIntelligence.Api
Jwt__SigningKey=dev-only-change-me-32-chars-minimum-key
Jwt__RequireHttpsMetadata=false
Jwt__AccessTokenMinutes=60
MediaAnalysis__MaxFileSizeBytes=104857600
MediaAnalysis__MaxProcessingAttempts=3
MediaAnalysis__PdfEofTailBytes=4096
VideoAnalysis__MaxVideosPerJob=5
VideoAnalysis__MaxVideoSizeBytes=1073741824
VideoAnalysis__MaxDurationSeconds=3600
VideoAnalysis__MaxProcessingAttempts=3
VideoAnalysis__DefaultMinConfidence=0.7
VideoAnalysis__DefaultMergeGapSeconds=2
VideoAnalysis__FaceMatchingEnabled=false
ImageBatchSearch__Enabled=false
ImageBatchSearch__MaxImagesPerJob=1000
ImageBatchSearch__MaxTargetsPerJob=200
ImageBatchSearch__MaxImageSizeBytes=104857600
ImageBatchSearch__AwsProviderEnabled=true
ImageBatchSearch__GoogleVisionProviderEnabled=true
ImageBatchSearch__DefaultMinConfidence=0.8
ImageBatchSearch__DefaultMinSimilarity=90
CloudAssets__AllowedS3Buckets__0=
CloudAssets__AllowedGcsBuckets__0=
CloudAssets__DefaultStagingTtlDays=3
CloudAssets__MinStagingTtlDays=1
CloudAssets__MaxStagingTtlDays=7
CloudAssets__MonthlySweepEnabled=true
CloudAssets__MaxAssetsPerJob=10000
CloudAssets__MaxVideosPerJob=100
CloudAssets__MaxImagesPerJob=10000
CloudAssets__MaxTargetsPerJob=200
CloudAssets__MaxConcurrentJobsPerClient=5
CloudAssets__MaxConcurrentProviderCallsPerClient=10
CloudAssets__MaxVideoDurationSeconds=14400
CloudAssets__MaxAssetSizeBytes=
AnalysisWorker__Enabled=true
AnalysisWorker__PollIntervalSeconds=2
WebhookDelivery__Enabled=true
WebhookDelivery__PollIntervalSeconds=2
WebhookDelivery__MaxAttempts=3
WebhookDelivery__InitialBackoffSeconds=5
WebhookDelivery__RequestTimeoutSeconds=10
Readiness__RequireGoogleDocumentAi=true
Readiness__CheckGoogleDocumentAiRemote=true
Readiness__TimeoutSeconds=10
GoogleDocumentAiStatusCache__RemoteStatusTtlSeconds=60
GoogleDocumentAiStatusCache__RemoteStatusTimeoutSeconds=10
Swagger__Enabled=true
POSTGRES_DB=media_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
